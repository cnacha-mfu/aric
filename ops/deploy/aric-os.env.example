# ARIC OS settings (installed as /etc/aric-os.env, readable by root and the aric group only)
ARIC_DB=/var/lib/aric-os/aric.db
ARIC_HOST=127.0.0.1
ARIC_PORT=8090
# Admins see everything; everyone else who signs in is staff and sees only what they are given
ARIC_ADMIN_EMAILS=nacha.cho@mfu.ac.th
ARIC_EMAIL_DOMAINS=mfu.ac.th,lamduan.mfu.ac.th
ARIC_SECURE_COOKIE=1
ARIC_AUTORELOAD=1
ARIC_SESSION_HOURS=168
# Thai time for "today", due dates and timestamps (the VM clock is UTC)
TZ=Asia/Bangkok
